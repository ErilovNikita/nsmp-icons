{
  "name": "nsmp-icons",
  "version": "1.1.0",
  "type": "module",
  "description": "SVG icon library for NSMP applications",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ErilovNikita/nsmp-icons.git"
  },
  "homepage": "https://github.com/ErilovNikita/nsmp-icons#readme",
  "bugs": {
    "url": "https://github.com/ErilovNikita/nsmp-icons/issues"
  },
  "keywords": [
    "icons",
    "svg",
    "nsmp"
  ],
  "files": [
    "icons/*.svg",
    "src/**/*.js",
    "src/**/*.d.ts",
    "LICENSE",
    "README.md",
    "preview.png"
  ],
  "scripts": {
    "generate:index": "node scripts/generate-index.mjs",
    "prepack": "npm run generate:index"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./vue": {
      "types": "./src/vue/index.d.ts",
      "import": "./src/vue/index.js"
    },
    "./vue/*": {
      "types": "./src/vue/*.d.ts",
      "import": "./src/vue/*.js"
    },
    "./icons/*.svg": {
      "types": "./src/icons.d.ts",
      "default": "./icons/*.svg"
    }
  },
  "types": "./src/index.d.ts",
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}
